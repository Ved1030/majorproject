{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "zip-drop\\.vercel\\.app" }],
      "destination": "https://www.getzipdrop.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zip-drop\\.vercel\\.app" }],
      "destination": "https://www.getzipdrop.com/:path*",
      "permanent": true
    }
  ]
}
